# Environment
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Data: raw MEPS files are large (93 MB xlsx) and re-downloadable from AHRQ;
# processed data is regenerated by the notebooks.
data/*.xlsx
data/raw/*.xlsx
data/processed/*
!data/processed/.gitkeep

# Office lock files
~$*

# Models (regenerated by training notebooks)
models/*
!models/.gitkeep

# Secrets
.env
